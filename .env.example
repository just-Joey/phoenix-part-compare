# Claude API — used for spec research + comparison synthesis
ANTHROPIC_API_KEY=

# Neon Auth base URL — gates the /api/* routes behind a signed-in session.
# From Neon console > Auth > Configuration; strip the trailing
# "/.well-known/jwks.json" from the JWKS URL shown there.
NEON_AUTH_URL=

# Only sessions with one of these emails (comma-separated) can reach /api/*.
# Neon Auth allows anyone to sign up, so this is the real access boundary.
ALLOWED_USER_EMAILS=

# Postgres connection string (Neon or any Postgres works)
DATABASE_URL="postgresql://user:password@host:5432/phoenix_compare?sslmode=require"

# Port for the local API server
PORT=4000

# How many days a cached comparison stays valid before re-fetching.
# Spec sheets rarely change; pricing does, so keep this modest.
COMPARISON_CACHE_DAYS=14

# Optional: how long a distributor availability check stays cached, in hours.
# This should be much shorter than the spec cache since stock changes daily.
AVAILABILITY_CACHE_HOURS=6
